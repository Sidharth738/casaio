# ==============================================================================
# Casaio E-Commerce Platform - Environment Variables Template
# Copy this file to .env.local and populate the secrets.
# ==============================================================================

# Client-Side Firebase Configuration (Publicly accessible in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyFakeDevApiKeyForCasaioApp12345
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=casaio-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=casaio-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=casaio-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=109876543210
NEXT_PUBLIC_FIREBASE_APP_ID=1:109876543210:web:abcdef1234567890

# Google Maps Platform (Places Autocomplete & Geocoding)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyFakeGoogleMapsKeyPlaceholder123

# Application Base URL
NEXT_PUBLIC_APP_URL=https://casaio.in

# Contact form delivery (use a Gmail App Password, not your normal password)
CONTACT_EMAIL_USER=casaio.official@gmail.com
CONTACT_EMAIL_APP_PASSWORD=replace-with-gmail-app-password

# Production distributed rate limiting (Upstash Redis REST API). Required in production.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# ==============================================================================
# Server-Side Only Secrets (NEVER expose to browser bundle)
# ==============================================================================

# Firebase Admin SDK Credentials
# In production, can use GOOGLE_APPLICATION_CREDENTIALS path or inline JSON
