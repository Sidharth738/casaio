# ==============================================================================
# Casaio E-Commerce Platform - Environment Variables Template
# Copy this file to .env.local and populate the secrets.
# ==============================================================================

# Client-Side Firebase Configuration (Publicly accessible in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyFakeDevApiKeyForCasaioApp12345
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=casaio-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=casaio-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=casaio-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=109876543210
NEXT_PUBLIC_FIREBASE_APP_ID=1:109876543210:web:abcdef1234567890

# Razorpay Client Key (Public test/live key)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholderKey123

# Google Maps Platform (Places Autocomplete & Geocoding)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyFakeGoogleMapsKeyPlaceholder123

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Server-Side Only Secrets (NEVER expose to browser bundle)
# ==============================================================================

# Firebase Admin SDK Credentials
# In production, can use GOOGLE_APPLICATION_CREDENTIALS path or inline JSON
FIREBASE_PROJECT_ID=casaio-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-casaio@casaio-app.iam.gserviceaccount.com
# Note: In .env.local, replace literal newlines with \n in the private key string
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3\n-----END PRIVATE KEY-----\n"

# Razorpay Secret Key (Used strictly server-side for HMAC signature verification)
RAZORPAY_KEY_ID=rzp_test_placeholderKey123
RAZORPAY_KEY_SECRET=rzp_secret_placeholderSecretKey123
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_placeholderWebhookSecret123

# Admin Setup / Bootstrap Secret (For initial role provisioning)
ADMIN_BOOTSTRAP_SECRET=casaio_master_secret_change_in_production
