# Local-only emulator mode. Set these in the local process, never production.
# This mode is pinned to demo-casaio-rules and loopback emulator endpoints.
# NEXT_PUBLIC_CASAIO_FIREBASE_EMULATORS=true
# FIREBASE_PROJECT_ID=demo-casaio-rules
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-casaio-rules

# Razorpay mode is server-selected. Replace placeholders with test credentials.
# Live mode is accepted only in production when the explicit opt-in is true.
RAZORPAY_MODE=test
RAZORPAY_LIVE_PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_KEY_SECRET_MODE=test
RAZORPAY_WEBHOOK_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET_MODE=test
# Optional local simulation requires both lines and no Razorpay credentials:
# RAZORPAY_MODE=simulation
# RAZORPAY_SIMULATION_ENABLED=true
