# ==============================================================================
# Casaio E-Commerce Platform - Environment Variables Template
# Copy this file to .env.local and populate the secrets.
# ==============================================================================

# Client-Side Firebase Configuration (Publicly accessible in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyFakeDevApiKeyForCasaioApp12345
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=casaio-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=casaio-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=casaio-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=109876543210
NEXT_PUBLIC_FIREBASE_APP_ID=1:109876543210:web:abcdef1234567890

# Google Maps Platform (Places Autocomplete & Geocoding)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyFakeGoogleMapsKeyPlaceholder123

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Server-Side Only Secrets (NEVER expose to browser bundle)
# ==============================================================================

# Firebase Admin SDK Credentials
# In production, can use GOOGLE_APPLICATION_CREDENTIALS path or inline JSON
FIREBASE_PROJECT_ID=casaio-app
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key from your Firebase service-account JSON. Keep it secret.
FIREBASE_PRIVATE_KEY=

# Local-only emulator mode. Set these in the local process, never production.
# This mode is pinned to demo-casaio-rules and loopback emulator endpoints.
# NEXT_PUBLIC_CASAIO_FIREBASE_EMULATORS=true
# FIREBASE_PROJECT_ID=demo-casaio-rules
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-casaio-rules

# Razorpay mode is server-selected. Replace placeholders with test credentials.
# Live mode is accepted only in production when the explicit opt-in is true.
RAZORPAY_MODE=test
RAZORPAY_LIVE_PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_KEY_SECRET_MODE=test
RAZORPAY_WEBHOOK_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET_MODE=test
# Optional local simulation requires both lines and no Razorpay credentials:
# RAZORPAY_MODE=simulation
# RAZORPAY_SIMULATION_ENABLED=true
