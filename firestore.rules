rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Core Helper Functions
    // =========================================================================

    function getUserData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isAuthenticated() {
      return request.auth != null &&
        request.auth.token.email_verified == true && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        getUserData().status != 'suspended'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      // Firestore profile role is authoritative so stale custom claims cannot
      // preserve seller/admin access after a role change.
      return isAuthenticated() &&
        getUserData().role == role &&
        getUserData().status != 'suspended';
    }

    function isAdmin() {
      // Admin status is assigned through trusted server tooling. Admins can
      // access admin data without email verification; other roles still need
      // a verified email through isAuthenticated().
      return request.auth != null &&
        getUserData().role == 'admin' &&
        getUserData().status != 'suspended';
    }

    function isSeller() {
      return hasRole('seller');
    }

    // =========================================================================
    // Users
    // =========================================================================

    match /users/{userId} {

      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId);

      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(['role', 'status'])
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    // Sellers
    // =========================================================================

    match /sellers/{sellerId} {

      allow read: if (
        resource.data.status == 'approved' ||
        isOwner(sellerId) ||
        isAdmin()
      );

      allow create: if isOwner(sellerId) && request.resource.data.status == 'pending';

      allow update: if (
        isAdmin() ||
        (
          isOwner(sellerId) &&
          resource.data.status == 'approved' &&
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(['status', 'commissionRatePercent'])
        )
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // Categories
    // =========================================================================

    match /categories/{categoryId} {

      allow read: if true;

      allow write: if isAdmin();
    }

    // =========================================================================
    // Products
    // =========================================================================

    match /products/{productId} {

      allow read: if (
        resource.data.status == 'active' ||
        (
          isAuthenticated() &&
          resource.data.sellerId == request.auth.uid
        ) ||
        isAdmin()
      );

      allow create: if (
        (
          isSeller() &&
          request.resource.data.sellerId == request.auth.uid
        ) ||
        isAdmin()
      );

      allow update: if (
        (
          isSeller() &&
          resource.data.sellerId == request.auth.uid &&
          request.resource.data.sellerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'slug', 'description', 'shortDescription', 'price',
            'compareAtPrice', 'costPerItem', 'sku', 'stock',
            'lowStockThreshold', 'categoryId', 'categorySlug', 'tags',
            'images', 'hasVariants', 'status', 'updatedAt'
          ])
        ) ||
        isAdmin()
      );

      allow delete: if (
        (
          isSeller() &&
          resource.data.sellerId == request.auth.uid
        ) ||
        isAdmin()
      );
    }

    // =========================================================================
    // Shopping Carts
    // =========================================================================

    match /carts/{userId} {

      allow read, write: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // Wishlists
    // =========================================================================

    match /wishlists/{userId} {

      allow read, write: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // Addresses
    // =========================================================================

    match /addresses/{addressId} {

      allow read: if (
        isOwner(resource.data.userId) ||
        isAdmin()
      );

      allow create: if (
        isAuthenticated() &&
        request.resource.data.userId == request.auth.uid
      );

      allow update: if (
        isOwner(resource.data.userId) ||
        isAdmin()
      );

      allow delete: if (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
    }

    // =========================================================================
    // Orders
    // =========================================================================

    match /orders/{orderId} {

      allow read: if (
        isAuthenticated() &&
        (
          resource.data.customerId == request.auth.uid ||
          resource.data.sellerIds.hasAny([request.auth.uid]) ||
          isAdmin()
        )
      );

      allow create: if (
        isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid
      );

      // Order mutations go through authenticated server routes, which enforce
      // seller ownership per line item and maintain payment/status integrity.
      allow update: if false;

      allow delete: if isAdmin();
    }

    // =========================================================================
    // Reviews
    // =========================================================================

    match /reviews/{reviewId} {

      allow read: if (
        resource.data.status == 'published' ||
        isAdmin()
      );

      allow create: if (
        isAuthenticated() &&
        request.resource.data.userId == request.auth.uid
      );

      allow update: if (
        (
          isOwner(resource.data.userId) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'comment', 'images', 'updatedAt'
          ])
        ) ||
        isAdmin()
      );

      allow delete: if (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
    }

    // =========================================================================
    // Coupons
    // =========================================================================

    match /coupons/{couponId} {

      allow read: if isAuthenticated() || isAdmin();

      allow write: if isAdmin();
    }

    // =========================================================================
    // Notifications
    // =========================================================================

    match /notifications/{notificationId} {

      allow read: if (
        isOwner(resource.data.userId) ||
        isAdmin()
      );

      allow update: if (
        isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['read'])
      );

      allow create, delete: if isAdmin();
    }

    // =========================================================================
    // Default Deny
    // =========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
