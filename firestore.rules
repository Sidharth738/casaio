rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Core Helper Functions
    // =========================================================================

    function getUserData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isAuthenticated() {
      return request.auth != null &&
        request.auth.token.email_verified == true && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        getUserData().status != 'suspended'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      // Firestore profile role is authoritative so stale custom claims cannot
      // preserve seller/admin access after a role change.
      return isAuthenticated() &&
        getUserData().role == role &&
        getUserData().status != 'suspended';
    }

    function isAdmin() {
      // Admin status is assigned through trusted server tooling. Admins can
      // access admin data without email verification; other roles still need
      // a verified email through isAuthenticated().
      return request.auth != null &&
        getUserData().role == 'admin' &&
        getUserData().status != 'suspended';
    }

    function isSeller() {
      return hasRole('seller') &&
        exists(/databases/$(database)/documents/sellers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.status == 'approved';
    }

    function validSellerInventoryUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['stock', 'updatedAt']) &&
        (!changed.hasAny(['stock']) || (request.resource.data.stock is int && request.resource.data.stock >= 0)) &&
        (!changed.hasAny(['updatedAt']) || request.resource.data.updatedAt is string);
    }

    // =========================================================================
    // Users
    // =========================================================================

    match /users/{userId} {

      allow read: if isOwner(userId) || isAdmin();

      // Self-service profiles are always ordinary active customer profiles.
      // Trusted Admin SDK provisioning bypasses these client-side rules.
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'role', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'customer' &&
        request.resource.data.status == 'active' &&
        request.resource.data.email is string &&
        request.resource.data.displayName is string &&
        request.resource.data.createdAt is string &&
        request.resource.data.updatedAt is string &&
        (!('photoURL' in request.resource.data) ||
          request.resource.data.photoURL == null || request.resource.data.photoURL is string);

      allow update: if (
        isOwner(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['displayName', 'phoneNumber', 'photoURL', 'defaultShippingAddressId', 'updatedAt'])
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    // Sellers
    // =========================================================================

    match /sellers/{sellerId} {

      // Seller documents contain payout details and private business metrics.
      // Public product documents carry the storefront-safe seller display name.
      allow read: if isOwner(sellerId) || isAdmin();

      // Applications and seller profile changes go through validated server
      // routes so clients cannot write commission, payout, or metric fields.
      allow create, update: if false;

      allow delete: if isAdmin();
    }

    // =========================================================================
    // Categories
    // =========================================================================

    match /categories/{categoryId} {

      allow read: if true;

      allow write: if isAdmin();
    }

    // =========================================================================
    // Products
    // =========================================================================

    match /products/{productId} {

      allow read: if (
        (isSeller() && resource.data.sellerId == request.auth.uid) ||
        isAdmin()
      );

      // Product creation and full product edits use validated server APIs.
      allow create: if false;

      // Sellers can update inventory directly. All other seller writes use
      // validated server APIs (including unique slug and category checks).
      allow update: if isSeller() &&
        resource.data.sellerId == request.auth.uid &&
        request.resource.data.sellerId == request.auth.uid &&
        validSellerInventoryUpdate();

      // Product lifecycle changes and deletion guards live in server APIs.
      allow delete: if false;
    }

    match /productPrivate/{productId} {
      allow read: if isAdmin() || (
        isSeller() &&
        get(/databases/$(database)/documents/products/$(productId)).data.sellerId == request.auth.uid
      );
      // Private product fields are read by the owner/admin client and written
      // only by trusted Admin SDK routes.
      allow write: if false;
    }

    // =========================================================================
    // Shopping Carts
    // =========================================================================

    match /carts/{userId} {

      allow read, write: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // Wishlists
    // =========================================================================

    match /wishlists/{userId} {

      allow read, write: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // Addresses
    // =========================================================================

    match /addresses/{addressId} {

      allow read: if (
        isOwner(resource.data.userId) ||
        isAdmin()
      );

      allow create: if (
        isAuthenticated() &&
        request.resource.data.userId == request.auth.uid
      );

      allow update: if (
        isOwner(resource.data.userId) ||
        isAdmin()
      );

      allow delete: if (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
    }

    // =========================================================================
    // Orders
    // =========================================================================

    match /orders/{orderId} {

      // Multi-vendor privacy: Sellers must not read shared multi-vendor order documents directly
      // from client SDK. Sellers access their scoped projections via authenticated server APIs.
      allow read: if isOwner(resource.data.customerId) || isAdmin();

      // Orders are created only by the trusted checkout API.
      allow create: if false;

      // Order mutations go through authenticated server routes, which enforce
      // seller ownership per line item and maintain payment/status integrity.
      allow update: if false;

      allow delete: if isAdmin();
    }

    // =========================================================================
    // Reviews
    // =========================================================================

    match /reviews/{reviewId} {

      allow read: if (
        resource.data.status == 'published' ||
        isAdmin()
      );

      // Review submission and moderation use validated server APIs.
      allow create, update, delete: if false;
    }

    // =========================================================================
    // Coupons
    // =========================================================================

    match /coupons/{couponId} {

      allow read: if isAuthenticated() || isAdmin();

      // Coupon definitions and usage counters are managed only by trusted
      // server routes. Admin UI writes must pass through those routes.
      allow write: if false;
    }

    // Normalized-code reservations are server-owned and permanent so a
    // deactivated or deleted coupon code cannot be reused by clients.
    match /couponCodes/{codeId} {
      allow read, write: if false;
    }

    // =========================================================================
    // Notifications
    // =========================================================================

    match /notifications/{notificationId} {

      allow read: if (
        isOwner(resource.data.userId) ||
        isAdmin()
      );

      allow update: if (
        isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['read'])
      );

      allow create, delete: if isAdmin();
    }

    // =========================================================================
    // Default Deny
    // =========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
