rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() &&
        request.auth.uid == userId &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.keys().hasAll(['status']) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isSeller() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.exists(/databases/(default)/documents/sellers/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.keys().hasAll(['role', 'status']) &&
        firestore.get(/databases/(default)/documents/sellers/$(request.auth.uid)).data.keys().hasAll(['status']) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'seller' &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active' &&
        firestore.get(/databases/(default)/documents/sellers/$(request.auth.uid)).data.status == 'approved';
    }
    
    function isAdmin() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.keys().hasAll(['role', 'status']) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isMedia() {
      return request.resource.contentType.matches('(image|video)/.*');
    }
    
    function isBelowMaxSize(maxMegaBytes) {
      return request.resource.size <= maxMegaBytes * 1024 * 1024;
    }

    // Product Images: Uploaded by seller, public read
    match /products/{sellerId}/{imageId} {
      allow read: if true;
      allow write: if ((isSeller() && request.auth.uid == sellerId || isAdmin()) && isMedia() &&
        ((request.resource.contentType.matches('image/.*') && request.resource.size <= 10 * 1024 * 1024) ||
         (request.resource.contentType.matches('video/.*') && request.resource.size <= 50 * 1024 * 1024)));
      allow delete: if ((isSeller() && request.auth.uid == sellerId) || isAdmin());
    }

    // Category cover images are uploaded by administrators only.
    match /categories/{adminId}/{imageId} {
      allow read: if true;
      allow write: if isAdmin() && request.auth.uid == adminId && isImage() && isBelowMaxSize(5);
      allow delete: if isAdmin() && request.auth.uid == adminId;
    }

    // Review Images: Uploaded by user, public read
    match /reviews/{userId}/{imageId} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage() && isBelowMaxSize(3);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Seller KYC Documents: Read/write only by seller and admin
    match /sellers/{sellerId}/kyc/{docId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow write: if isOwner(sellerId) && isImage() && isBelowMaxSize(10) ||
        isOwner(sellerId) && request.resource.contentType == 'application/pdf' && isBelowMaxSize(10);
      allow delete: if isAdmin();
    }

    // Store Branding / Avatars
    match /avatars/{userId}/{imageId} {
      allow read: if true;
      allow write: if isOwner(userId) && isImage() && isBelowMaxSize(2);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
